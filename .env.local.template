# Copy to .env.local and fill in, then run:
#   docker compose --env-file .env.local up -d

# Required secrets. DB_PASSWORD is embedded in a connection URL, so keep it
# URL-safe; generate both with `openssl rand -hex 32`
DB_PASSWORD=
AUTH_SECRET=

# Sign-in: an OpenID Connect provider (its issuer URL, which must serve
# /.well-known/openid-configuration). Register Mantle as a confidential client
# with the redirect URI <APP_URL>/api/auth/callback/omni
AUTH_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# The provider's JWKS endpoint (the `jwks_uri` in its discovery document)
AUTH_JWKS_URL=

# Give each user a personal workspace when the provider sends no Omni workspace
# claims (any provider other than Omni Gatekeeper). Set to false with Gatekeeper
# PERSONAL_WORKSPACE_FALLBACK=true

# Public URLs (what the browser uses)
# APP_URL=http://localhost:3000
# API_URL=http://localhost:4000

# Optional overrides
# MANTLE_API_IMAGE=api.manifold.omni.dev/omnidotdev/mantle-api:latest
# MANTLE_APP_IMAGE=api.manifold.omni.dev/omnidotdev/mantle-app:latest
# DB_NAME=mantle
# DB_USER=postgres
# API_PORT=4000
# APP_PORT=3000
